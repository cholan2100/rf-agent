# ==============================================================================
# RF Workbench Linux Environment - Configuration
# ==============================================================================

# Path on your host to mount into the Linux container at /workspace.
# By default, this points to the parent directory '..' (D:\Workspace\rf)
# so all sibling RF projects (lna-ai, LNA_FM_thin_v2, adsb-hackrf, etc.)
# are immediately accessible inside /workspace.
# You can also point to a specific project folder (e.g. ../lna-ai or D:\Workspace\rf\lna-ai).
PROJECT_PATH=..

# Port for browser-based interactive GUI desktop (noVNC)
# Navigate to http://localhost:6080 to access KiCad, FreeCAD, Qucs-S, AppCSXCAD
WEB_PORT=6080

# Port for direct VNC clients (TigerVNC, RealVNC, etc.)
VNC_PORT=5900

# Port for MCP server / API access
MCP_PORT=8000

# Resolution for the virtual desktop
RESOLUTION=1920x1080

# Password for VNC / web desktop session (leave blank or change as desired)
VNC_PASSWORD=rfworkbench
