# ==============================================================================
# RF Agent Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Selection: 'local' (default) or 'aws'
# - 'local': Runs rf-suite Docker container locally (WSL / Docker Desktop)
# - 'aws': Offloads compute (KiCad, FreeCAD, openEMS, Qucsator) to AWS EC2 host
# ------------------------------------------------------------------------------
RF_BACKEND=local

# ------------------------------------------------------------------------------
# AWS Remote Execution Settings (Required when RF_BACKEND=aws)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_INSTANCE_ID=i-0123456789abcdef0
AWS_S3_BUCKET=rf-suite-workspace-example-bucket

# Remote connection method: 'ssm' (recommended, no open ports needed) or 'ssh'
RF_REMOTE_METHOD=ssm

# Remote paths on the EC2 host (defaults match cloudformation / terraform user-data)
RF_REMOTE_WORKSPACE=/opt/rf-agent-host/workspace
RF_COMPOSE_DIR=/opt/rf-agent-host/rf-suite

# ------------------------------------------------------------------------------
# Optional SSH Fallback Configuration (Only needed if RF_REMOTE_METHOD=ssh)
# ------------------------------------------------------------------------------
# AWS_SSH_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
# AWS_SSH_USER=ubuntu
# AWS_SSH_KEY=~/.ssh/my-rf-key.pem

# ------------------------------------------------------------------------------
# Desktop & VNC Display Settings
# ------------------------------------------------------------------------------
RESOLUTION=1920x1080
VNC_PASSWORD=rfworkbench
WEB_PORT=6080
VNC_PORT=5900
MCP_PORT=8000
